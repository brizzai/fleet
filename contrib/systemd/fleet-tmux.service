# Optional systemd user unit: start the tmux server at login so fleet's
# agent sessions are already alive before you open the TUI, and survive
# closing your terminal.
#
# fleet itself is a foreground TUI — it is not a daemon and needs no unit.
# The tmux server it shares is the thing worth supervising, and only if you
# want sessions to outlive your login session:
#
#   mkdir -p ~/.config/systemd/user
#   cp contrib/systemd/fleet-tmux.service ~/.config/systemd/user/
#   systemctl --user enable --now fleet-tmux.service
#
# To keep sessions running after you log out entirely (e.g. a headless box
# you SSH into), also enable lingering:
#
#   loginctl enable-linger "$USER"

[Unit]
Description=tmux server for fleet agent sessions

[Service]
Type=forking
# start-server only: no windows are created; fleet attaches its sessions to
# this server as usual. exit-empty defaults to on, which means a server with
# zero sessions and no attached client exits again almost immediately
# (reproducible: `tmux -f /dev/null -L t start-server; sleep 1; tmux -L t ls`
# -> "no server running") — turning it off in the same invocation, before
# systemd considers the unit started, is what makes the server actually
# persist. `env` resolves tmux via PATH rather than a hardcoded path, so this
# also works for Homebrew-on-Linux, Nix, or from-source installs.
ExecStart=/usr/bin/env tmux start-server \; set -s exit-empty off
# Don't tear the server (and every agent session in it) down when the unit
# stops — leave that to `tmux kill-server` as a deliberate act. KillMode=none
# is deprecated (systemd >= 243 warns on load); process + a no-op ExecStop is
# the supported way to express the same "never signal it" intent.
RemainAfterExit=yes
KillMode=process
ExecStop=/bin/true

[Install]
WantedBy=default.target
